# MT5 Container Configuration
# KasmVNC basic auth — gives a full desktop inside the container (MT5 terminal).
# REQUIRED. Generate with: openssl rand -base64 24
CUSTOM_USER=change_me
PASSWORD=
MT5_API_PORT=5001
LOG_LEVEL=WARNING
BROKER_TIMEZONE_OFFSET=3

# MT5 API Authentication — REQUIRED. Without it every endpoint returns 503.
# Generate with: openssl rand -hex 32
# Put the same value in the main .env as MT5_REST_API_KEY (bot + dashboard).
# MT5_API_AUTH_DISABLED=true turns auth off — local development only.
MT5_API_KEY=

# MT5 Session Configuration
MT5_PERSIST_LOGIN=0
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=
MT5_PATH=
MT5_TIMEOUT=60000

# MT5 Cache Configuration
MT5_ACCOUNT_INFO_TTL=0.1
MT5_TICK_TTL=0.1

# WebSocket Configuration
MAX_WS_CLIENTS=200
MAX_WS_SYMBOLS_PER_CLIENT=50
WS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Metrics Configuration
METRICS_MAX_REQUEST_TIMES=1000

# Server Configuration
USE_EVENTLET=1
MAX_CONTENT_LENGTH=1048576

# Logging Configuration
LOG_FILE=
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5