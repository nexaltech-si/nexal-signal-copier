# Telegram Configuration - Telethon (for listening and sending messages)
# OPTIONAL: leave all three empty to run without Telegram (e.g. Discord only), or set
# them later in the dashboard (AI & Bot → Telegram). Get them from https://my.telegram.org
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_PHONE=
# Discord needs nothing here: its token and channels are set on the dashboard's Discord page.
TELEGRAM_SESSION_NAME=sessions/trading_bot_session
TELEGRAM_WEB_AUTH_PORT=5000

# Settings Encryption Key — REQUIRED. Encrypts the API keys and tokens stored in the
# database, and the bot ↔ dashboard internal token is derived from it. The bot does not
# start without it. `./deploy.sh --init` generates one; by hand:
#   python3 -c "import base64,os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
# Keep it safe and never change it afterwards: saved secrets cannot be read with another key.
SETTINGS_ENCRYPTION_KEY=

# ===========================================
# DASHBOARD LOGIN (Clerk) — REQUIRED for the dashboard
# ===========================================
# The dashboard signs users in with Clerk (free plan is enough): create an application at
# https://dashboard.clerk.com and copy both keys from "API keys".
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/
# The ONE Clerk user allowed to use the dashboard (it controls a live trading account).
# Sign up once, then copy your user id (user_...) from Clerk → Users. Everyone else is refused.
AUTHORIZED_USER_ID=

# Port the dashboard is published on, on the server's loopback interface only
DASHBOARD_PORT=3000
# Only if services on the Docker host (local Ollama, brain endpoint) are not reachable:
# DOCKER_HOST_GATEWAY=172.17.0.1

# Channels to monitor (OPTIONAL - configure via Dashboard instead)
# Leave empty to configure via Dashboard: https://your-domain/config
TELEGRAM_CHANNEL_ID=
# For multiple channels in .env, use comma-separated: @channel1,@channel2,-1001234567890

# Notification settings (OPTIONAL - configure via Dashboard instead)
TELEGRAM_NOTIFICATION_CHAT_ID=
# Get your user ID from @userinfobot

# Telegram Bot API (optional - for bot-based notifications)
# Get bot token from @BotFather: https://t.me/BotFather
TELEGRAM_BOT_TOKEN=
# Bot will use TELEGRAM_NOTIFICATION_CHAT_ID for sending messages

# Trading Provider Selection: 'metaapi' (cloud SDK) or 'mt5rest' (self-hosted MT5 REST API)
TRADING_PROVIDER=metaapi

# MetaAPI Cloud SDK Configuration (used when TRADING_PROVIDER=metaapi)
METAAPI_TOKEN=
METAAPI_ACCOUNT_ID=
# Streamed reads avoid MetaAPI per-call rate limits (true/false)
METAAPI_USE_STREAMING=true

# Self-hosted MT5 REST API Configuration (used when TRADING_PROVIDER=mt5rest)
# Docker: http://mt5:5001 (via mt5-net external network)
# Local dev: http://localhost:5001
MT5_REST_API_URL=http://mt5:5001
MT5_REST_API_KEY=

# Broker symbol suffix (e.g. ".fx" → EURUSD.fx). Tried first before brute-force fallback.
# Works with both MetaAPI and MT5 REST providers. Leave empty if broker uses standard names.
MT5_SYMBOL_SUFFIX=.fx

# EA mirror-execution feed. Your primary account is unaffected — it keeps
# trading via MetaAPI exactly as it does today. This feed lets OTHER MT5
# accounts (mt5/EA/NexalSignalMirrorEA.mq5) independently open the same
# trades your primary account already has RUNNING, each sized from its own
# equity. Only trades that cleared approval (or never needed it) AND
# actually filled can ever appear here — see ea_signals_router.py's module
# docstring for exactly why.
#
# EA_API_KEY: the backend's own secret for GET /api/ea/signals on trading-bot
# (port 8001). trading-bot is bound to 127.0.0.1 only and never exposed to the
# internet, so nothing outside this host ever sends this key — it is also
# reused internally by the dashboard's proxy route to reach the backend. Fails
# closed (503) if left unset.
EA_API_KEY=
#
# What each individual EA authenticates with (InpApiKey) is NOT set here —
# there is no single shared public key anymore. Each customer/mirror account
# gets their own key, issued, expired and revoked from the dashboard's
# Configuration → API Keys page (/settings/api-keys), stored hashed in the
# api_keys table. See docs/EA_MIRROR_SETUP.md.

# AI Configuration - OpenAI
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4-turbo-preview

# AI Configuration - DeepSeek
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_API_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-v4-flash  # v4-flash is faster and cheaper ($0.14/1M input tokens)

# AI Configuration - Ollama (Local)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama2

# AI Configuration - MiniMax (OpenAI compatible — https://platform.minimaxi.com/docs/api-reference/text-openai-api)
# Get API key from https://platform.minimaxi.com/user-center/basic-information/interface-key
MINIMAX_API_KEY=
MINIMAX_BASE_URL=https://api.minimax.io/v1
MINIMAX_MODEL=MiniMax-M2.7  # or MiniMax-M2.5, MiniMax-Text-01
MINIMAX_VISION_MODEL=MiniMax-VL-01  # Vision model for image/chart analysis

# AI Configuration - Qwen / Alibaba DashScope (OpenAI compatible)
# Get API key from https://dashscope-intl.aliyuncs.com/ (international) or https://dashscope.aliyuncs.com/ (China)
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-plus  # or qwen-max, qwen-turbo
QWEN_VISION_MODEL=qwen-vl-max  # Vision model for image/chart analysis

# AI Selection (openai, deepseek, ollama, perplexity, openrouter, minimax, qwen, or all for fallback)
PRIMARY_AI_PROVIDER=openai
FALLBACK_AI_PROVIDERS=deepseek,ollama

# ===========================================
# AI TRADING BRAIN
# ===========================================
# Conversational LLM session that reviews every incoming signal and actively
# manages open positions (HOLD / MODIFY_SL / MODIFY_TP / PARTIAL_CLOSE / CLOSE).
#
# ⚠️  These settings are managed in the dashboard (AI section) — configure
#     them there, not here. The database value ALWAYS takes precedence over
#     any value set in this file. The lines below are documentation-only.
#
# ENABLE_TRADING_BRAIN=true
#   Master switch. When false the brain is bypassed and all signals are approved.
#
# BRAIN_BASE_URL=
#   Point to a Hermes /v1/responses endpoint for server-side conversation state,
#   e.g. http://hermes:8080/v1. Leave empty to use the configured AI provider
#   (OpenAI / DeepSeek) with client-side history instead.
#
# BRAIN_API_KEY=
#   API key for the brain endpoint. Stored encrypted in the database.
#   Leave empty to reuse the active provider key (OPENAI_API_KEY / DEEPSEEK_API_KEY).
#
# BRAIN_MODEL=
#   Model override for the brain, e.g. gpt-4o or deepseek-chat.
#   Leave empty to inherit the active provider's configured model.
#
# BRAIN_TEMPERATURE=0.3
#   Sampling temperature (0.0–1.0). Lower = more deterministic decisions.
#
# BRAIN_MAX_HISTORY_MESSAGES=60
#   Number of conversation turns kept in memory before the oldest are trimmed.
#
# BRAIN_POSITION_REVIEW_INTERVAL=30
#   Seconds between brain reviews for each open position.

# Risk Management
MAX_RISK_PER_TRADE_PERCENT=2.0
MAX_OPEN_POSITIONS=5
DEFAULT_STOP_LOSS_PIPS=60  # Auto-calculated when SL is missing
DEFAULT_TAKE_PROFIT_PIPS=40
RISK_REWARD_RATIO=2.0
SPREAD_ADJUSTMENT_MULTIPLIER=1.0  # Multiplier for spread adjustment on SL to avoid immediate closure

# MetaAPI Equity Protection (for Prop Firm Accounts)
ENABLE_EQUITY_PROTECTION=true
DAILY_DRAWDOWN_LIMIT_PERCENT=3.0
OVERALL_DRAWDOWN_LIMIT_PERCENT=10.0
ENABLE_DRAWDOWN_MONITORING=true

# Trading Configuration
MIN_LOT_SIZE=0.01
MAX_LOT_SIZE=1.0
SLIPPAGE_PIPS=3

# Message Age Validation (Prevent executing old signals)
MAX_SIGNAL_AGE_MINUTES=5  # Reject signals older than X minutes (prevents executing old messages on bot restart)

# Instant Market Order Execution (for specific channels)
ENABLE_INSTANT_EXECUTION=true  # Enable instant market order execution
INSTANT_EXECUTION_CHANNELS=  # Comma-separated channel IDs allowed for instant execution (leave empty to allow all)
# Example: INSTANT_EXECUTION_CHANNELS=-1001234567890,-1009876543210
INSTANT_EXECUTION_KEYWORDS=now,instant,market,immediately,asap  # Keywords that trigger instant execution

# Manual Trade Approval Settings
REQUIRE_MANUAL_APPROVAL=false  # Global switch: if true, ALL signals require approval (unless in APPROVAL_SKIP_CHANNELS)
APPROVAL_REQUIRED_CHANNELS=  # Specific channels that REQUIRE approval (comma-separated channel IDs)
# Example: APPROVAL_REQUIRED_CHANNELS=-1001234567890,@risky_channel
# If empty and REQUIRE_MANUAL_APPROVAL=false, no approval needed
# If empty and REQUIRE_MANUAL_APPROVAL=true, all channels require approval
APPROVAL_CHANNEL_ID=  # Channel ID where approval requests are sent (your private chat with bot)
# Get your chat ID from @userinfobot or use your TELEGRAM_NOTIFICATION_CHAT_ID
APPROVAL_TIMEOUT_MINUTES=4  # Auto-reject signals after X minutes without approval
ALLOW_HIGH_RISK_OVERRIDE=false  # If true, a signal that only fails because its risk exceeds
# MAX_RISK_PER_TRADE_PERCENT is sent for manual approval with a high-risk disclaimer instead of
# being auto-rejected. You can then accept the extra risk or skip the trade. (Lot size is already
# reduced to the minimum, so approving trades at the smallest possible position.) Default: false.

# Auto Take Profit Settings
ENABLE_AUTO_TAKE_PROFIT=true
AUTO_TP_CALCULATION_METHOD=RR  # PIPS or RR (Risk-Reward)
AUTO_TP_PIPS=50  # Used if method is PIPS
AUTO_TP_RISK_REWARD=2.0  # Used if method is RR (e.g., 2.0 = 1:2 RR)

# Trailing Stop Loss Settings
ENABLE_TRAILING_STOP=true
TRAILING_STOP_CALCULATION_METHOD=PIPS  # PIPS or RR
TRAILING_STOP_DISTANCE_PIPS=15  # Distance in pips behind current price
TRAILING_STOP_DISTANCE_RR=0.5  # Distance as RR ratio (if using RR method)
TRAILING_ACTIVATION_METHOD=PROFIT_PIPS  # PROFIT_PIPS, PROFIT_RR, PARTIAL_TP, IMMEDIATE
TRAILING_ACTIVATION_PROFIT_PIPS=20  # Activate after X pips profit
TRAILING_ACTIVATION_PROFIT_RR=1.0  # Activate after X:1 RR profit

# Auto Partial Profit Taking Settings
ENABLE_AUTO_PARTIAL=true  # Enable auto partial profit taking
AUTO_PARTIAL_CALCULATION_METHOD=RR  # PIPS or RR (Risk-Reward)
AUTO_PARTIAL_TRIGGER_PIPS=30  # Take partials after X pips profit (if using PIPS)
AUTO_PARTIAL_TRIGGER_RR=1.5  # Take partials after X:1 RR profit (if using RR)
AUTO_PARTIAL_CLOSE_PERCENT=50.0  # Close X% of position as partial
ENABLE_RUNNER_SPLIT=false  # Place part of every signal without a take profit (runner)
RUNNER_SHARE_PERCENT=50.0  # Percent of the signal's lots placed without TP

# Breakeven Settings
ENABLE_BREAKEVEN_MOVE=true  # Move SL to breakeven when profitable
BREAKEVEN_TRIGGER_METHOD=AFTER_PARTIAL  # AFTER_PARTIAL, PROFIT_PIPS, or AFTER_SIBLING_TP_HIT
BREAKEVEN_TRIGGER_PIPS=15  # Move to breakeven after X pips profit (only if method is PROFIT_PIPS)
BREAKEVEN_BUFFER_PIPS=2  # Add buffer above/below entry (e.g., +2 pips)
BREAKEVEN_MIN_SIBLING_TP_HITS=1  # For AFTER_SIBLING_TP_HIT: min number of sibling TPs that must hit before triggering BE (for multi-TP signals)

# Position Monitoring
POSITION_MONITOR_INTERVAL_SECONDS=5  # How often to check positions
ENABLE_POSITION_MONITORING=true  # Master switch for auto TP/trailing/breakeven

# AI Market Analysis Features (Advanced)
ENABLE_AI_MARKET_ANALYSIS=false  # Master switch for AI-powered market analysis
AI_ANALYSIS_CHECK_INTERVAL=30  # Check market conditions every X seconds
ENABLE_AI_BREAKEVEN_TRIGGERS=false  # AI detects adverse trends and suggests breakeven
ENABLE_AI_TP_ADJUSTMENT=false  # AI suggests TP adjustments based on market strength
ENABLE_AI_POSITION_REDUCTION=false  # AI suggests partial closes in unfavorable conditions
AI_ANALYSIS_CONFIDENCE_THRESHOLD=0.7  # Confidence level needed to act (0.0-1.0)

# Database Configuration (Prisma)
# NOTE: Prisma resolves relative paths from the prisma/ directory
DATABASE_URL="file:../data/trading_bot.db"
# For PostgreSQL: DATABASE_URL="postgresql://user:password@localhost:5432/trading_bot"
# For MySQL: DATABASE_URL="mysql://user:password@localhost:3306/trading_bot"

# Redis Configuration (for candle caching and real-time data)
# Docker: redis://trading-redis:6379
# Local dev: redis://localhost:6379
REDIS_URL=redis://trading-redis:6379

# News Trading Filter (Economic Calendar)
NEWS_ENABLE_FILTER=true  # Enable news-based trading blocks
NEWS_MINUTES_BEFORE=10  # Block trading X minutes before news
NEWS_MINUTES_AFTER=5  # Block trading X minutes after news
NEWS_IMPORTANT_IMPACTS=High,Medium  # Which impact levels to monitor
NEWS_TARGET_CURRENCIES=EUR,USD,CAD,JPY,GBP  # Currencies to monitor
NEWS_API_URL=https://nfs.faireconomy.media/ff_calendar_thisweek.json
# News posts to a channel (own filter; does not change which news blocks trading)
NEWS_POST_ENABLED=false
NEWS_POST_CHANNEL_ID=
NEWS_POST_IMPACTS=High
NEWS_POST_CURRENCIES=USD
NEWS_POST_MINUTES_BEFORE=30
# News fetched ONCE per week on Monday at 1 AM (API provides entire week's data)
NEWS_UPDATE_INTERVAL_HOURS=168  # Not used (weekly update only)
NEWS_VERBOSE_LOGGING=false  # Enable detailed news logs
NEWS_ENABLE_NOTIFICATIONS=true  # Send notifications for upcoming news
NEWS_NOTIFICATION_MINUTES_BEFORE=10  # Notify X minutes before news

# General Settings
LOG_LEVEL=DEBUG  # Terminal output level - Options: DEBUG, INFO, WARNING, ERROR
LOG_FILE_LEVEL=  # File output level (optional, defaults to LOG_LEVEL if not set)
LOG_FILE_DEBUG=false  # Set to true to force DEBUG level in log files (overrides LOG_FILE_LEVEL)
DRY_RUN=false
TIMEZONE=UTC

# ===========================================
# SIGNAL VALIDATOR API
# ===========================================
# Enable external signal validation before trade execution
ENABLE_SIGNAL_VALIDATOR=false

# API URL — use Docker-internal URL when validator runs on the same server (docker-compose):
#   SIGNAL_VALIDATOR_URL=http://signal-validator:8000
# Use its public URL when the validator is hosted externally, e.g. https://validator.example.com
SIGNAL_VALIDATOR_URL=http://signal-validator:8000

# API key for authentication (X-API-Key header)
SIGNAL_VALIDATOR_API_KEY=

# Timeout in seconds before treating the API as unreachable (fail-open)
SIGNAL_VALIDATOR_TIMEOUT_SECONDS=5

# Execution policy — controls which validator verdicts are allowed to trade:
#   ALL        — trade regardless of verdict (VALID, WARN, INVALID all pass through)
#   VALID_WARN — block only INVALID signals; VALID and WARN proceed  (recommended)
#   VALID_ONLY — only VALID passes; WARN and INVALID are blocked
SIGNAL_VALIDATOR_EXECUTION_POLICY=VALID_WARN

# ===========================================
# DASHBOARD TRAEFIK CONFIGURATION
# ===========================================
# Domain for accessing the dashboard through Traefik (optional; leave as is without Traefik)
DASHBOARD_DOMAIN=dashboard.example.com

# Dashboard Basic Authentication
# Username for dashboard access
DASHBOARD_USERNAME=admin

# Hashed password for dashboard access
# Generate with: htpasswd -nbB admin YourPasswordHere | sed -e s/\\$/\\$\\$/g
DASHBOARD_HASHED_PASSWORD=
