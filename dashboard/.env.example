# MetaAPI Credentials (for Performance Analytics)
METAAPI_TOKEN=your_metaapi_token_here
METAAPI_ACCOUNT_ID=your_account_id_here

# Database URL (for Prisma) - Relative to prisma/schema.prisma
# This path works across different servers/deployments
DATABASE_URL="file:../../data/trading_bot.db"

DEEPSEEK_API_KEY=your_deepseek_api_key_here

# Internal URL for the Python backend (trading-bot). Never exposed publicly —
# only this dashboard is. Docker: http://trading-bot:8001. Local dev: http://localhost:8001
PYTHON_API_URL=http://trading-bot:8001

# GET /api/ea/signals — per-customer-key-protected proxy to the backend's EA
# mirror-execution feed (see root .env.example). Consumed by
# mt5/EA/NexalSignalMirrorEA.mq5, which places real orders on other MT5
# accounts. Must match the backend's own EA_API_KEY exactly.
EA_API_KEY=

# AUTHORIZED_USER_ID: the Clerk user id allowed to issue/revoke API keys
# (Configuration → API Keys) and other admin-only actions in this dashboard
# — see src/lib/auth.ts. Required for the API Keys page to let anyone in.
AUTHORIZED_USER_ID=
