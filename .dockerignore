# Not needed in the trading-bot (Python) image — these dominate the build context
# and only bloat the image / slow `COPY . .`. The trading-bot app never reads them:
#   mt5/       — MT5 EA source + self-hosted MT5 REST app (3+ GB), built/run separately
#   dashboard/ — Next.js app, built from its own ./dashboard context
# (This .dockerignore applies only to the trading-bot build, whose context is the repo
#  root; the dashboard image builds from ./dashboard and is unaffected.)
mt5/
dashboard/
backups/
